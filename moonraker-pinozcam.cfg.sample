# PiNozCam for Moonraker -- sample configuration.
#
# Copy to ~/printer_data/config/moonraker-pinozcam.cfg and edit.
# Mainsail and Fluidd can edit this file directly in the browser
# (Machine -> Configuration Files); no SSH needed.

[moonraker]
host = 127.0.0.1
port = 7125
# api_key =        # only if Moonraker's authorization is enabled

[camera]
# Snapshot URL. On a stock Klipper install crowsnest serves this.
snapshot_url = http://127.0.0.1:8080/?action=snapshot
# rotate = 0       # 0/90/180/270
# flip_h = false
# flip_v = false

[detection]
# These defaults match the OctoPrint build exactly, so a user moving a
# printer between the two gets the same behaviour rather than having to
# re-tune. Do not change one without changing the other.

# Confidence a detection needs before it counts toward severity.
score_threshold = 0.87

# Area sensitivity: severity = affected_area / this, clamped to [0,1].
# A frame "alarms" at severity >= 0.5, i.e. 2% of the frame at 0.04.
sensitivity = 0.04

# Fraction of frames in the window that must alarm before acting.
failure_ratio = 0.05

# Sliding window length, seconds.
count_time = 120

# Seconds to skip at the start of a print. 0 means detect immediately.
start_delay = 0

# Share of the performance cores the detector may use: 0.25, 0.5, 0.75, 1.0.
# Same scale and same default as the OctoPrint build's CPU Speed Control.
#
# Extra cores buy less than their count suggests on these in-order hosts:
# measured 2 to 4 cores is +15% on an A55 (RK3566) and +8% on an A53
# (Pi 3B+), because they are memory-latency bound and wait on memory
# together. Raising this to 1.0 is safe on an NPU board, where the CPU only
# fetches and scales frames.
cpu_share = 0.5

[web]
# Serves the annotated frame (detection boxes drawn on the camera image).
#   http://<printer>:58888/snapshot   single frame
#   http://<printer>:58888/stream     MJPEG
#
# This is not a settings UI -- it exists so the annotated view can be added
# to Mainsail/Fluidd as just another webcam. Obico does not need a local
# port because it ships frames to its cloud; PiNozCam has no cloud, so the
# view has to be reachable locally.
#
# 58888 is deliberately far from 8080/8081, which crowsnest uses for real
# cameras. Set to 0 to disable and rely on Telegram/Discord alone.
port = 58888

# Register the above with Moonraker on startup, so it appears in
# Mainsail/Fluidd's camera list with no manual setup. Set false to leave
# Moonraker's database untouched and add it yourself.
register_webcam = true

[action]
# What to do when a failure is confirmed: none | pause | stop
on_failure = pause

[telegram]
# enabled = false
# token =
# chat_id =

[discord]
# enabled = false
# bot_token =
# channel_id =

[logging]
# path = ~/printer_data/logs/moonraker-pinozcam.log
# level = INFO
