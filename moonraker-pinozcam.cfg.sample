# PiNozCam for Moonraker -- sample configuration.
#
# Copy to ~/printer_data/config/moonraker-pinozcam.cfg and edit.
# Mainsail and Fluidd can edit this file directly in the browser
# (Machine -> Configuration Files); no SSH needed.
#
# ⚠️ Every setting below mirrors the OctoPrint build's settings_schema.py --
# same names, same defaults, same ranges -- so a printer moved between the
# two behaves identically. The ONE deliberate difference is cpu_share, and
# the reason is recorded next to it. Sections marked "Klipper only" have no
# OctoPrint counterpart because OctoPrint supplies that information itself.

# ---- Klipper only: how to reach Moonraker -------------------------------
[moonraker]
host = 127.0.0.1
port = 7125
# api_key =        # only if Moonraker's authorization is enabled

# ---- Detection ----------------------------------------------------------
[detection]
# Master switch.                                    (enableAI)
enable_ai = true

# auto | cpu | rknn | awnn | acl | bpu | vulkan | coreml
# Forcing a backend fails loudly if that hardware is absent, rather than
# quietly using something else.                     (aiBackend)
ai_backend = auto

# What to do on a confirmed failure:
#   0 = notify only, 1 = pause, 2 = stop            (action)
action = 0

# Seconds to skip at the start of a print.          (aiStartDelay)
ai_start_delay = 0

# Extra seconds between detections. 0 = no added delay.
#                                                   (detectionInterval)
detection_interval = 0

# Area sensitivity: severity = affected_area / this, clamped to [0,1].
# A frame alarms at severity >= 0.5.                (imgSensitivity)
img_sensitivity = 0.04

# Confidence a detection needs before it counts.    (scoresThreshold)
scores_threshold = 0.87

# Sliding window length in seconds, 10-3600.        (countTime)
count_time = 120

# Fraction of frames in the window that must alarm, 0.01-1.0.
#                                                   (failureRatio)
failure_ratio = 0.05

# ⚠️ print_layout_threshold is deliberately absent. The OctoPrint build
# has the setting and nothing in it reads the value either -- it is stored
# and never used. Shipping a control that does nothing is worse than not
# having one, so this build leaves it out rather than reproducing it. The
# key is still read if present, so an imported config will not break.

# Milliseconds between samples, 10-1000.            (frameSampleInterval)
frame_sample_interval = 200

# Candidate buffer, both 4-16.        (frameBufferMaxAge/frameBufferCapacity)
frame_buffer_max_age = 4
frame_buffer_capacity = 5

# ⚠️ THE ONE DELIBERATE DIFFERENCE FROM THE OCTOPRINT BUILD.
# Share of the performance cores the detector may use, 0.01-1.0.
# OctoPrint defaults this to 0.5; here it is 0.75, because the constraint
# it protects against does not exist on Klipper. OctoPrint streams gcode
# line by line, so a stalled host marks the print; Klipper computes a step
# schedule and pushes about a second of it to the MCU ahead of time
# (BUFFER_TIME_HIGH = 1.0), which absorbs host stalls entirely. Measured on
# a CB2 under saturation, Klipper's serial threads were kept off the CPU for
# 0.5 ms out of 15 s.                               (cpuSpeedControl)
cpu_share = 0.75

# ---- Camera -------------------------------------------------------------
[camera]
# Leave empty to discover the camera automatically: Moonraker's webcam list
# first (which also supplies rotation and flip), then Klipper's standard
# nginx path /webcam/. Set it to override.          (customSnapshotURL)
snapshot_url =

# Mask: MASK_GRID x MASK_GRID of "0"/"1", row-major, "1" = ignore.
# Usually painted in the UI rather than typed.      (maskImageData)
# mask_image_data =

# ---- Notifications ------------------------------------------------------
[telegram]
enabled = false                                   # (enableTelegram)
token =                                           # (telegramBotToken)
chat_id =                                         # (telegramChatID)

[discord]
enabled = false                                   # (enableDiscord)
bot_token =                                       # (discordBotToken)
channel_id =                                      # (discordChannelID)

[notification]
# Maximum alerts per print. 0 = unlimited.          (maxNotification)
max_notification = 0
# Minimum seconds between alerts; suppressed ones are dropped, not queued.
#                                                   (notifyInterval)
notify_interval = 60

# ---- Printer identity ---------------------------------------------------
[printer]
# Shown in alerts so one chat can serve several printers. Empty = derived
# from Moonraker.                                   (printerId)
name =

# ---- Klipper only: the annotated view -----------------------------------
[web]
# Serves the annotated frame (detection boxes drawn on the camera image):
#   http://<printer>:58888/snapshot   single frame
#   http://<printer>:58888/stream     MJPEG
#
# This exists because a Klipper build has no plugin UI to draw into. It is
# registered with Moonraker so it appears in Mainsail/Fluidd's camera list.
# Set port to 0 to disable and rely on Telegram/Discord alone.
port = 58888

# Optional password for the page and the settings API. Empty = no login,
# which is the default. Set it with:
#
#     ~/moonraker-pinozcam-env/bin/python -m moonraker_pinozcam \
#         -c ~/printer_data/config/moonraker-pinozcam.cfg --set-password
#
# ⚠️ Snapshots and the stream stay open even with a password set, so
# PiNozCam keeps working in Mainsail's camera list -- Mainsail renders a
# webcam as a plain <img> that carries no credentials. The picture is
# already served without a login by your host's own camera on port 80, so
# this exposes nothing new; what the password protects is everything that
# can change the printer or read what is configured.
#
# ⚠️ There is no TLS here. A password stops someone browsing to the port;
# it does not stop someone who can watch the traffic. Do not port-forward
# this port either way.
user = pinozcam
password =
register_webcam = true

# ---- Logging ------------------------------------------------------------
[logging]
# Both optional. By default PiNozCam logs to the journal AND to
# <printer_data>/logs/moonraker-pinozcam.log -- the same directory klippy,
# moonraker and crowsnest use, which is what Mainsail's Machine -> Logs
# page lists. Set path to move it, or write `path =` with nothing after it
# to turn the file off and keep only `journalctl -u moonraker-pinozcam`.
# path = ~/printer_data/logs/moonraker-pinozcam.log
# level = INFO
